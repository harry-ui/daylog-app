# 去 https://console.anthropic.com 申请 API Key。留空 = mock 模式，不会花钱。
ANTHROPIC_API_KEY=
# 填了 ANTHROPIC_API_KEY 就必须设置：随便一串长一点的字符，App 的 .env 里 EXPO_PUBLIC_API_TOKEN 填成一样的。
# 生成一个：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DAYLOG_API_TOKEN=
# 可选：每个设备 10 分钟内最多生成几次
DAYLOG_RATE_LIMIT=20
# 可选：换成别的模型
DAYLOG_MODEL=claude-haiku-5-5
